{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eft-calculator.local/schemas/ammo.schema.json",
  "title": "Ammo",
  "type": "object",
  "required": ["id", "name", "short_name", "caliber", "damage", "penetration_power", "armor_damage_percent"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "short_name": {"type": "string", "minLength": 1},
    "caliber": {"type": "string", "minLength": 1},
    "damage": {"type": "number", "minimum": 0, "maximum": 1000},
    "penetration_power": {"type": "number", "minimum": 0, "maximum": 200},
    "armor_damage_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "projectile_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "aliases": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
