{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eft-calculator.local/schemas/preset.schema.json",
  "title": "TarkovSimPreset",
  "type": "object",
  "required": ["schema_version", "ammo", "armor_layers"],
  "properties": {
    "schema_version": {"const": 1},
    "ammo": {"$ref": "ammo.schema.json"},
    "armor_layers": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "armor.schema.json"}},
    "body_part": {"enum": ["thorax", "head", "stomach"]},
    "distance_m": {"type": "number", "minimum": 0, "maximum": 2000},
    "shot_count": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "additionalProperties": true
}
