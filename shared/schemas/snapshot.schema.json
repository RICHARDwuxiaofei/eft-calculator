{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eft-calculator.local/schemas/snapshot.schema.json",
  "title": "NormalizedDataSnapshot",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "created_at", "sources", "ammo"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "ammo": {"type": "array", "items": {"$ref": "ammo.schema.json"}},
    "armor": {"type": "array", "items": {"$ref": "armor.schema.json"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
